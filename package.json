{
  "name": "@epam/eslint-config-angular",
  "version": "3.0.0",
  "description": "ESLint configuration for Angular projects with stricter rules and RxJS support",
  "main": "index.mjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EPAM-JS-Competency-center/eslint-config-angular.git"
  },
  "author": {
    "name": "Sergey Gultyayev",
    "email": "gultyayev.sergey@gmail.com"
  },
  "scripts": {
    "release": "standard-version",
    "prepublishOnly": "if [ -n \"$(git status --porcelain)\" ]; then echo 'Uncommitted changes: commit or stash them before publishing.' >&2; exit 1; fi; node -e \"import('./index.mjs')\""
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "prettier --write CHANGELOG.md"
    }
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "LICENSE",
    "README.md",
    "configs"
  ],
  "keywords": [
    "eslint",
    "config",
    "angular"
  ],
  "types": "index.d.mts",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-rxjs-x": "^1.0.6"
  },
  "peerDependencies": {
    "angular-eslint": "^22.0.0",
    "eslint": "^10.0.1",
    "rxjs": "^7.2.0",
    "typescript": ">=4.8.4 <6.1.0",
    "typescript-eslint": "^8.56.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "rxjs": "^7.8.2",
    "standard-version": "^9.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
